# Coin Vault configuration. Copy to backend/.env for development, or let
# deploy/lxc/install.sh write /etc/coinvault/coinvault.env for you.
# Never commit a real .env.

# PostgreSQL in production; SQLite works for development.
CV_DATABASE_URL=postgresql+psycopg://coinvault:CHANGE_ME@127.0.0.1:5432/coinvault
# CV_DATABASE_URL=sqlite:///./coinvault.db

# Photo originals, thumbnails and documents (not stored in the database).
CV_MEDIA_ROOT=/var/lib/coinvault/media

# Encrypts provider API keys (SoldComps, Metals.Dev) before they go in the database:
# 32 random bytes, base64 (openssl rand -base64 32). install.sh and update.sh create one.
# Keep it with your backups; without it, saved API keys can't be read and must be entered again.
CV_ENCRYPTION_KEY=

# Background jobs (spot price polling, daily usage sync). Only one process runs them.
CV_SCHEDULER_ENABLED=true
# Market hours and weekend pause are judged in this timezone.
CV_TIMEZONE=America/New_York

# Plain http on a private LAN needs false. Set true only behind HTTPS (e.g. Caddy).
CV_COOKIE_SECURE=false
CV_SESSION_TTL_HOURS=336

# Upload limits
CV_MAX_PHOTO_MB=40
CV_MAX_DOCUMENT_MB=25
CV_MAX_FILES_PER_UPLOAD=200

# When nginx fronts the app, it serves protected files itself after the app authorises them.
CV_USE_X_ACCEL=false
CV_X_ACCEL_PREFIX=/protected-media

# Only for running without nginx (development, Docker): FastAPI serves the built frontend.
# CV_FRONTEND_DIST=/opt/coinvault/app/frontend/dist

CV_LOG_LEVEL=INFO
CV_LOG_JSON=true
CV_RUN_MIGRATIONS_ON_STARTUP=true
